#: src/catalog.ts
msgid "{genre}: movies"
msgstr "{genre} : films"

#: src/catalog.ts
msgid "{genre}: series"
msgstr "{genre} : séries"

#: src/household.ts
msgid "12 profiles at most"
msgstr "12 profils au maximum"

#: src/household.ts
msgid "A PIN is 4 characters"
msgstr "Un code PIN fait 4 caractères"

#: src/household.ts
msgid "A profile with an age limit can’t change the other profiles"
msgstr "Un profil avec une limite d’âge ne peut pas modifier les autres profils"

#: src/catalog.ts
msgid "Anime"
msgstr "Animé"

#: src/downloads.ts
msgid "Download not found"
msgstr "Téléchargement introuvable"

#: src/catalog.ts
msgid "Japanese animated films"
msgstr "Films d’animation japonais"

#: src/household.ts
msgid "Keep at least one preset, with at least one language in it"
msgstr "Garde au moins un préréglage, avec au moins une langue"

#: src/household.ts
msgid "Keep at least one profile without an age limit"
msgstr "Gardez au moins un profil sans limite d’âge"

#: src/household.ts
msgid "Only the profile itself can change its age limit"
msgstr "Seul le profil lui-même peut changer sa limite d’âge"

#: src/catalog.ts
msgid "Popular movies"
msgstr "Films populaires"

#: src/catalog.ts
msgid "Popular series"
msgstr "Séries populaires"

#: src/household.ts
msgid "Profile 1"
msgstr "Profil 1"

#: src/qbit.ts
msgid "qBittorrent’s download folder is missing from the server settings"
msgstr "Le dossier de téléchargement de qBittorrent manque dans les réglages du serveur"

#: src/play.ts
msgid "Real-Debrid has no source ready for this title."
msgstr "Real-Debrid n’a aucune source prête pour ce titre."

#: src/catalog.ts
msgid "Season {n}"
msgstr "Saison {n}"

#: src/household.ts
msgid "Set this profile’s PIN code first"
msgstr "Définissez d’abord le code PIN de ce profil"

#: src/downloads.ts
msgid "Source or title missing"
msgstr "Source ou titre manquant"

#: src/downloads.ts
msgid "The Jellyfin library folder isn’t set in the server settings"
msgstr "Le dossier de la bibliothèque Jellyfin n’est pas indiqué dans les réglages du serveur"

#: src/lgtv.ts
msgid "The TV doesn’t accept connections. Check that Developer Mode is on."
msgstr "La TV n’accepte pas les connexions. Vérifiez que le mode développeur est activé."

#: src/lgtv.ts
msgid "The TV doesn’t answer at this address. Check the address, that the TV is on, and that Key Server is on in its Developer Mode app."
msgstr "La TV ne répond pas à cette adresse. Vérifiez l’adresse, que la TV est allumée, et que Key Server est activé dans son application Developer Mode."

#: src/lgtv.ts
msgid "The TV refused the connection. Turn Key Server off and on again in its Developer Mode app, then retry."
msgstr "La TV a refusé la connexion. Désactivez puis réactivez Key Server dans son application Developer Mode, puis réessayez."

#: src/lgtv.ts
msgid "The TV refused to install the app. Check that Developer Mode is still on, then retry."
msgstr "La TV a refusé d’installer l’application. Vérifiez que le mode développeur est toujours activé, puis réessayez."

#: src/devices.ts
msgid "This code has expired"
msgstr "Ce code a expiré"

#: src/devices.ts
msgid "This code is wrong or has expired"
msgstr "Ce code est faux ou a expiré"

#: src/devices.ts
msgid "This device is no longer connected"
msgstr "Cet appareil n’est plus connecté"

#: src/qbit.ts
msgid "This download contains no video."
msgstr "Ce téléchargement ne contient aucune vidéo."

#: src/play.ts
msgid "This file is no longer in Jellyfin."
msgstr "Ce fichier n’est plus dans Jellyfin."

#: src/play.ts
msgid "This file is no longer in qBittorrent."
msgstr "Ce fichier n’est plus dans qBittorrent."

#: src/lgtv.ts
msgid "This isn’t a TV’s address. It looks like 192.168.1.42."
msgstr "Ce n’est pas l’adresse d’une TV. Elle ressemble à 192.168.1.42."

#: src/household.ts
msgid "This profile has no PIN"
msgstr "Ce profil n’a pas de code PIN"

#: src/http.ts
msgid "This profile is locked with a PIN"
msgstr "Ce profil est protégé par un code PIN"

#: src/http.ts
msgid "This profile was deleted"
msgstr "Ce profil a été supprimé"

#: src/household.ts
msgid "This profile’s PIN is needed to change it"
msgstr "Le code PIN de ce profil est nécessaire pour le modifier"

#: src/household.ts
msgid "This profile’s settings PIN is needed to add a profile"
msgstr "Le code PIN des réglages de ce profil est nécessaire pour ajouter un profil"

#: src/sources.ts
msgid "This source isn’t ready on Real-Debrid yet"
msgstr "Cette source n’est pas encore prête sur Real-Debrid"

#: src/play.ts
msgid "This title is above this profile’s age limit"
msgstr "Ce titre dépasse la limite d’âge de ce profil"

#: src/play.ts
#: src/sources.ts
msgid "This version is no longer listed. Search again."
msgstr "Cette version n’est plus proposée. Relance la recherche."

#: src/devices.ts
msgid "Too many devices are waiting to be connected. Try again in a few minutes."
msgstr "Trop d’appareils attendent d’être connectés. Réessaie dans quelques minutes."

#: src/household.ts
msgid "Too many wrong PINs. Try again in a minute."
msgstr "Trop de codes PIN erronés. Réessayez dans une minute."

#: src/catalog.ts
msgid "Top rated movies"
msgstr "Films les mieux notés"

#: src/catalog.ts
msgid "Top rated series"
msgstr "Séries les mieux notées"

#: src/catalog.ts
msgid "Trending movies"
msgstr "Films tendance"

#: src/catalog.ts
msgid "Trending series"
msgstr "Séries tendance"

#: src/household.ts
msgid "Type a PIN for its settings"
msgstr "Tapez un code PIN pour ses réglages"

#: src/catalog.ts
msgid "Unknown category"
msgstr "Catégorie inconnue"

#: src/household.ts
msgid "Unknown preset"
msgstr "Préréglage inconnu"

#: src/lgtv.ts
msgid "Wrong passphrase. Type the 6 characters the TV’s Developer Mode app shows, capitals included."
msgstr "Phrase secrète incorrecte. Saisissez les 6 caractères affichés par l’application Developer Mode de la TV, majuscules comprises."

#: src/household.ts
msgid "Wrong PIN"
msgstr "Code PIN erroné"
