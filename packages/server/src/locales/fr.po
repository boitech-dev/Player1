msgstr "Profil 1"

#: src/qbit.ts
msgid "qBittorrent’s download folder is missing from the server settings"
msgstr "Le dossier de téléchargement de qBittorrent manque dans les réglages du serveur"

#: src/play.ts
msgid "Real-Debrid has no source ready for this title."
msgstr "Real-Debrid n’a aucune source prête pour ce titre."

#: src/catalog.ts
msgid "Season {n}"
msgstr "Saison {n}"

#: src/downloads.ts
msgid "Source or title missing"
msgstr "Source ou titre manquant"

#: src/downloads.ts
msgid "The Jellyfin library folder isn’t set in the server settings"
msgstr "Le dossier de la bibliothèque Jellyfin n’est pas indiqué dans les réglages du serveur"

#: src/lgtv.ts
msgid "The TV doesn’t accept connections. Check that Developer Mode is on."
msgstr "La TV n’accepte pas les connexions. Vérifiez que le mode développeur est activé."

#: src/lgtv.ts
msgid "The TV doesn’t answer at this address. Check the address, that the TV is on, and that Key Server is on in its Developer Mode app."
msgstr "La TV ne répond pas à cette adresse. Vérifiez l’adresse, que la TV est allumée, et que Key Server est activé dans son application Developer Mode."

#: src/lgtv.ts
msgid "The TV refused the connection. Turn Key Server off and on again in its Developer Mode app, then retry."
msgstr "La TV a refusé la connexion. Désactivez puis réactivez Key Server dans son application Developer Mode, puis réessayez."

#: src/lgtv.ts
msgid "The TV refused to install the app. Check that Developer Mode is still on, then retry."
msgstr "La TV a refusé d’installer l’application. Vérifiez que le mode développeur est toujours activé, puis réessayez."

#: src/devices.ts
msgid "This code has expired"
msgstr "Ce code a expiré"

#: src/devices.ts
msgid "This code is wrong or has expired"
msgstr "Ce code est faux ou a expiré"

#: src/devices.ts
msgid "This device is no longer connected"
msgstr "Cet appareil n’est plus connecté"

#: src/qbit.ts
msgid "This download contains no video."
msgstr "Ce téléchargement ne contient aucune vidéo."

#: src/play.ts
msgid "This file is no longer in Jellyfin."
msgstr "Ce fichier n’est plus dans Jellyfin."

#: src/play.ts
msgid "This file is no longer in qBittorrent."
msgstr "Ce fichier n’est plus dans qBittorrent."

#: src/lgtv.ts
msgid "This isn’t a TV’s address. It looks like 192.168.1.42."
msgstr "Ce n’est pas l’adresse d’une TV. Elle ressemble à 192.168.1.42."

#: src/sources.ts
