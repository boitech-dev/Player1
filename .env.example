# Optional. Settings are made in the app (first-run setup, then Devices > Server settings) and kept in data/config.json.
# A value here wins over that screen and shows there as read-only. install.sh writes PUID/PGID/PORT/BIND for Docker.
# RD_TOKEN=            https://real-debrid.com/apitoken
# TMDB_KEY=            https://www.themoviedb.org/settings/api
# STREAM_ADDON=        a Stremio stream addon URL (default: Torrentio with your Real-Debrid key)
# TORZNAB_URL=         e.g. https://c411.org/api/torznab, or a Prowlarr / Jackett indexer feed
# TORZNAB_KEY=
# QBIT_URL=            qBittorrent web UI
# QBIT_USER=
# QBIT_PASS=
# QBIT_FILES=          its download folder as this server sees it (empty on Whatbox: files are read over its file site)
# MEDIA_DIR=           Jellyfin library folder on this server (downloads go to MEDIA_DIR/player1)
# JELLYFIN_URL=
# JELLYFIN_KEY=
# PUBLIC_URL=          the address devices use; the TV app is built for it
# UPDATES=off          no automatic updates
