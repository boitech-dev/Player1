# Player1 behind Nginx (example: replace player.example.com). Then: certbot --nginx --redirect -d player.example.com
server {
	listen 80;
	listen [::]:80;
	server_name player.example.com;
	location / {
		proxy_pass http://127.0.0.1:6510;
		proxy_http_version 1.1;
		proxy_set_header Host $host;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Forwarded-For $remote_addr;
		# films and /api/events (devices, "send to") are long streams: passed through as they come, never cut
		proxy_buffering off;
		proxy_read_timeout 1d;
	}
}
